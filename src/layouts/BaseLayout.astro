---
import type { CollectionEntry } from 'astro:content'
import SiteHeader from '../components/layout/SiteHeader.astro'
import SiteFooter from '../components/layout/SiteFooter.astro'
import intelligenceReadings from '../data/intelligence-readings.json'
import '../styles/global.css'

type Settings = CollectionEntry<'settings'>['data']

interface Props {
  settings: Settings
  title?: string
  description?: string
  imageAlt?: string
}

const { settings, title, description = settings.description, imageAlt = title ?? settings.name } = Astro.props
const pageTitle = title ? `${title} | ${settings.name}` : settings.name
const canonical = new URL(Astro.url.pathname, Astro.site)
const socialImage = new URL('/assets/daisho-project-social.jpg', Astro.site)
const currentPath = Astro.url.pathname
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0a0809" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href="/assets/app-icon-500.png" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:site_name" content={settings.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1920" />
    <meta property="og:image:height" content="1080" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">本文へ移動</a>
    <div class="site-frame">
      <SiteHeader settings={settings} currentPath={currentPath} />
      <main id="main-content">
        <slot />
      </main>
      <SiteFooter settings={settings} />
    </div>
    <div class="terminal-loss terminal-loss-love" data-love-loss data-language-safe role="alertdialog" aria-modal="true" aria-label="愛を失いました" tabindex="-1" hidden>
      <p data-love-message data-message="愛を失ったら……人は……" data-fit-text data-fit-min="12"></p>
    </div>
    <div class="terminal-loss terminal-loss-vision" data-vision-loss data-language-safe role="alert" aria-label="視覚を失いました" hidden>
      <p>何も見えない……</p>
    </div>
    <script is:inline define:vars={{ intelligenceReadings }}>
      (() => {
        const storageKey = 'daisho-sacrifice-state-v1'
        const validEffects = new Set(['face', 'name', 'birthday', 'language', 'love', 'vision', 'color', 'intelligence'])
        const personalNames = ['えいとえいど', '紅芋けんぴ', 'EigHt']
        const birthdays = ['2月24日', '9月3日', '5月16日']
        const navigation = performance.getEntriesByType('navigation')[0]
        if (navigation?.type === 'reload') localStorage.removeItem(storageKey)

        const readState = () => {
          try {
            const saved = JSON.parse(localStorage.getItem(storageKey) ?? 'null')
            return Array.isArray(saved?.effects) ? saved.effects.filter((effect) => validEffects.has(effect)) : []
          } catch {
            return []
          }
        }
        const activeEffects = new Set(readState())
        const blockedParents = new Set(['SCRIPT', 'STYLE', 'NOSCRIPT', 'TEMPLATE'])
        const walker = document.createTreeWalker(document.body, NodeFilter.SHOW_TEXT, {
          acceptNode(node) {
            const parent = node.parentElement
            if (!parent || blockedParents.has(parent.tagName) || parent.closest('[data-language-safe]')) return NodeFilter.FILTER_REJECT
            return node.textContent?.trim() ? NodeFilter.FILTER_ACCEPT : NodeFilter.FILTER_REJECT
          },
        })
        const textEntries = []
        while (walker.nextNode()) {
          const node = walker.currentNode
          textEntries.push({
            node,
            original: node.textContent ?? '',
            inArticles: Boolean(node.parentElement?.closest('#articles')),
            birthdaySensitive: Boolean(node.parentElement?.closest('[data-birthday-loss]')),
          })
        }
        const privateTerms = [...personalNames, ...birthdays]
        const attributeEntries = [...document.querySelectorAll('[aria-label], [title], [alt], meta[content]')].flatMap((element) =>
          ['aria-label', 'title', 'alt', 'content']
            .filter((attribute) => element.hasAttribute(attribute))
            .map((attribute) => ({ element, attribute, original: element.getAttribute(attribute) ?? '' }))
            .filter((entry) => privateTerms.some((term) => entry.original.includes(term))),
        )
        const originalDocumentTitle = document.title

        const shiftUnicode = (text) => Array.from(text, (character) => {
          if (/\s/u.test(character) || character === '？') return character
          const codePoint = character.codePointAt(0)
          return codePoint === undefined ? character : String.fromCodePoint(codePoint + 10)
        }).join('')
        const redactPersonalDetails = (text) => {
          let redacted = text
          if (activeEffects.has('name')) personalNames.forEach((name) => { redacted = redacted.replaceAll(name, '？'.repeat(name.length)) })
          if (activeEffects.has('birthday')) birthdays.forEach((birthday) => { redacted = redacted.replaceAll(birthday, '？'.repeat(birthday.length)) })
          return redacted
        }
        const formatText = (text) => {
          const redactedOriginal = redactPersonalDetails(text)
          const base = redactedOriginal !== text
            ? redactedOriginal
            : activeEffects.has('intelligence') ? (intelligenceReadings[text] ?? text) : text
          return activeEffects.has('language') ? shiftUnicode(base) : base
        }
        const applyTextEffects = () => {
          const losesIntelligence = activeEffects.has('intelligence')
          const losesLanguage = activeEffects.has('language')
          textEntries.forEach((entry) => {
            const reading = losesIntelligence && !entry.inArticles ? intelligenceReadings[entry.original] : undefined
            const birthdayRedacted = activeEffects.has('birthday') && entry.birthdaySensitive
              ? entry.original.replace(/\S/gu, '？')
              : entry.original
            const redactedOriginal = redactPersonalDetails(birthdayRedacted)
            const base = redactedOriginal !== entry.original ? redactedOriginal : redactPersonalDetails(reading ?? entry.original)
            entry.node.textContent = losesLanguage ? shiftUnicode(base) : base
          })
          attributeEntries.forEach((entry) => {
            entry.element.setAttribute(entry.attribute, redactPersonalDetails(entry.original))
          })
          document.title = redactPersonalDetails(originalDocumentTitle)
        }

        const loveLoss = document.querySelector('[data-love-loss]')
        const loveMessage = loveLoss?.querySelector('[data-love-message]')
        const visionLoss = document.querySelector('[data-vision-loss]')
        let loveTimer = 0
        const showLove = (animate) => {
          if (!loveLoss || !loveMessage) return
          window.clearInterval(loveTimer)
          document.documentElement.classList.add('has-lost-love')
          document.body.classList.add('has-terminal-loss')
          document.body.style.overflow = 'hidden'
          loveLoss.hidden = false
          loveLoss.classList.toggle('is-active', animate)
          const message = loveMessage.dataset.message ?? ''
          loveMessage.textContent = animate ? '' : message
          if (animate && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
            window.setTimeout(() => {
              let index = 0
              loveTimer = window.setInterval(() => {
                loveMessage.textContent = message.slice(0, ++index)
                if (index >= message.length) window.clearInterval(loveTimer)
              }, 80)
            }, 900)
          } else if (animate) loveMessage.textContent = message
          loveLoss.focus()
        }
        const showVision = () => {
          if (!visionLoss) return
          document.body.classList.add('has-terminal-loss')
          visionLoss.hidden = false
        }

        const applyState = ({ animateLove = false } = {}) => {
          const losesLove = activeEffects.has('love')
          const losesVision = activeEffects.has('vision')
          document.documentElement.classList.toggle('has-lost-face', activeEffects.has('face'))
          document.documentElement.classList.toggle('has-lost-color', activeEffects.has('color'))
          document.documentElement.classList.toggle('has-lost-love', losesLove)
          document.body.classList.toggle('has-terminal-loss', losesLove || losesVision)
          document.body.style.overflow = losesLove ? 'hidden' : ''
          if (loveLoss && !losesLove) {
            loveLoss.hidden = true
            loveLoss.classList.remove('is-active')
          }
          if (visionLoss && !losesVision) visionLoss.hidden = true
          applyTextEffects()
          if (losesLove) showLove(animateLove)
          else if (losesVision) showVision()
        }
        const save = () => localStorage.setItem(storageKey, JSON.stringify({ effects: [...activeEffects] }))
        const notify = () => window.dispatchEvent(new CustomEvent('sacrifice:statechange', { detail: { effects: [...activeEffects] } }))

        window.daishoSacrifice = {
          activate(effect) {
            if (!validEffects.has(effect) || activeEffects.has(effect)) return
            activeEffects.add(effect)
            save()
            applyState({ animateLove: effect === 'love' })
            notify()
          },
          getState() {
            return [...activeEffects]
          },
          reset() {
            activeEffects.clear()
            localStorage.removeItem(storageKey)
            applyState()
            notify()
          },
          formatText,
        }
        document.querySelector('[data-sacrifice-reset]')?.addEventListener('click', () => {
          window.daishoSacrifice.reset()
        })
        window.addEventListener('storage', (event) => {
          if (event.key !== storageKey) return
          activeEffects.clear()
          readState().forEach((effect) => activeEffects.add(effect))
          applyState()
          notify()
        })
        applyState()
      })()
    </script>
    <script>
      const fitText = (element: HTMLElement) => {
        element.style.removeProperty('font-size')

        const maximum = Number.parseFloat(getComputedStyle(element).fontSize)
        const minimum = Number.parseFloat(element.dataset.fitMin ?? '16')
        let low = minimum
        let high = maximum

        if (element.scrollWidth <= element.clientWidth) return

        while (high - low > 0.25) {
          const size = (low + high) / 2
          element.style.fontSize = `${size}px`
          if (element.scrollWidth <= element.clientWidth) low = size
          else high = size
        }

        element.style.fontSize = `${low}px`
      }

      const fittedText = [...document.querySelectorAll<HTMLElement>('[data-fit-text]')]
      const fitAllText = () => fittedText.forEach(fitText)
      let resizeFrame = 0
      const queueTextFit = () => {
        cancelAnimationFrame(resizeFrame)
        resizeFrame = requestAnimationFrame(fitAllText)
      }

      document.fonts.ready.then(fitAllText)
      window.addEventListener('resize', queueTextFit, { passive: true })
      const textFitObserver = new MutationObserver(queueTextFit)
      fittedText.forEach((element) => textFitObserver.observe(element, { childList: true, characterData: true, subtree: true }))
      fitAllText()
    </script>
  </body>
</html>
