---
interface Article { title: string; source: string; publishedAt: Date; url: string; category: string; groups: string[]; image: string; draft: boolean }
interface Props { article: Article }
const { article } = Astro.props
const date = article.publishedAt.toLocaleDateString('ja-JP', { year: 'numeric', month: '2-digit', day: '2-digit' })
---
<article class="article-card" data-article-groups={article.groups.join('|')}>
  <a href={article.url} target="_blank" rel="noreferrer">
    <div class="article-media">
      <img src={article.image} alt={`${article.title}の見出し画像`} loading="lazy" decoding="async" referrerpolicy="no-referrer" />
    </div>
    <div class="article-copy">
      <p><span>{article.category}</span><time datetime={article.publishedAt.toISOString()}>{date}</time></p>
      <h3>{article.title}</h3>
      <span class="article-source">{article.source} ↗</span>
    </div>
  </a>
</article>
