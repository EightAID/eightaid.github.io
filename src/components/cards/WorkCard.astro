---
interface Work { title: string; year: number; link: string; image: string; thumbnail?: string; members: string[] }
interface Props { work: Work }
const { work } = Astro.props
const thumbnail = work.thumbnail ?? work.image
---

<article class="work-card">
  <a href={work.link} target="_blank" rel="noreferrer" aria-label={`${work.title}を見る（新しいタブ）`}>
    <div class="work-image-wrap">
      <img src={thumbnail} alt={`『${work.title}』のサムネイル`} width="512" height="512" loading="lazy" decoding="async" />
    </div>
    <div class="work-copy">
      <time datetime={String(work.year)}>{work.year}</time>
      <h3>{work.title}</h3>
      <span aria-hidden="true">↗</span>
    </div>
  </a>
</article>
