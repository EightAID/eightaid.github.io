---
import type { CollectionEntry } from 'astro:content'

type Work = CollectionEntry<'works'>
interface Props { work: Work }
const { work } = Astro.props
---

<article class="work-card">
  <a href={work.data.link} target="_blank" rel="noreferrer" aria-label={`${work.data.title}を見る（新しいタブ）`}>
    <div class="work-image-wrap">
      <img src={work.data.image} alt={work.data.imageAlt} width="512" height="512" loading="lazy" decoding="async" />
    </div>
    <div class="work-copy">
      <time datetime={String(work.data.year)}>{work.data.year}</time>
      <h3>{work.data.title}</h3>
      <span aria-hidden="true">↗</span>
    </div>
  </a>
</article>
