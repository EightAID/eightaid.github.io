---
interface Props { url: string }
const { url } = Astro.props
const host = new URL(url).hostname
const icon = host === 'indie.gamewith.jp' ? '/icons/services/gamewith.ico' : host === 'unityroom.com' ? '/icons/services/unityroom.png' : null
const path = host === 'x.com'
  ? 'M18.9 2H22l-6.8 7.8L23.2 22h-6.3L12 14.6 5.5 22H2.3l7.9-9L1 2h6.5l4.5 6.8L18.9 2ZM17.8 20h1.8L6.4 4H4.5l13.3 16Z'
  : host.includes('youtube.com')
  ? 'M23 7s-.2-2-1-2.8C21.2 3.4 20 3.4 20 3.4 16.8 3.2 12 3.2 12 3.2s-4.8 0-8 .2c0 0-1.2 0-2 .8C1.2 5 1 7 1 7S.8 9.2.8 11.5V13C.8 15.2 1 17.5 1 17.5s.2 2 1 2.8c.8.8 2 .8 2 .8 3.2.2 8 .2 8 .2s4.8 0 8-.2c0 0 1.2 0 2-.8.8-.8 1-2.8 1-2.8s.2-2.3.2-4.5v-1.5C23.2 9.2 23 7 23 7ZM10 16V8l7 4-7 4Z'
  : host === 'note.com'
  ? 'M4 3h6v2c1.3-1.5 3-2.2 5-2.2 4 0 6 2.6 6 7V21h-6V10.8c0-2-.7-3-2.3-3C11 7.8 10 9 10 11v10H4V3Z'
  : host === 'github.com'
  ? 'M12 2a10 10 0 0 0-3.2 19.5v-2.3c-2.6.6-3.2-1.1-3.2-1.1-.4-1-1-1.3-1-1.3-.8-.5 0-.5 0-.5.9 0 1.4.9 1.4.9.8 1.4 2.1 1 2.7.7.1-.6.3-1 .6-1.3-2.1-.2-4.3-1.1-4.3-4.9 0-1.1.4-2 1-2.7-.1-.3-.4-1.3.1-2.7 0 0 .9-.3 2.8 1a9.6 9.6 0 0 1 5.1 0c1.9-1.3 2.8-1 2.8-1 .5 1.4.2 2.4.1 2.7.6.7 1 1.6 1 2.7 0 3.8-2.2 4.7-4.3 4.9.4.3.7.9.7 1.8v3.1A10 10 0 0 0 12 2Z'
  : null
---
{icon ? <img class="service-icon" src={icon} width="16" height="16" alt="" /> : <svg class="service-icon" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" focusable="false">
  {path ? <path fill="currentColor" d={path} /> : host.endsWith('booth.pm') ? <g fill="none" stroke="currentColor" stroke-width="1.7"><path d="M3 10h18l-2-6H5l-2 6Zm1 0v11h16V10M9 21v-7h6v7" /></g> : <g fill="none" stroke="currentColor" stroke-width="1.7"><circle cx="12" cy="12" r="9"/><ellipse cx="12" cy="12" rx="4" ry="9"/><path d="M3 12h18"/></g>}
</svg>}
