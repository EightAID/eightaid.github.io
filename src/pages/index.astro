---
import { getCollection, getEntry } from 'astro:content'
import BaseLayout from '../layouts/BaseLayout.astro'
import SectionHeading from '../components/ui/SectionHeading.astro'
import MemberCard from '../components/cards/MemberCard.astro'
import ProductCard from '../components/cards/ProductCard.astro'
import ArticleCard from '../components/cards/ArticleCard.astro'

const settings = await getEntry('settings', 'site')
const home = await getEntry('home', 'home')
const members = (await getCollection('members')).sort((a, b) => a.data.order - b.data.order)
const products = (await getCollection('products')).sort((a, b) => a.data.order - b.data.order)
const articlesCatalog = await getEntry('articles', 'all')
const articles = (articlesCatalog?.data.items ?? [])
  .filter((article) => !article.draft)
  .sort((a, b) => b.publishedAt.getTime() - a.publishedAt.getTime())
const history = (await getCollection('history')).sort((a, b) => a.data.order - b.data.order)
const isFourDigitYear = (value: string) => /^\d{4}$/.test(value)
if (!settings || !home) throw new Error('Required site content is missing')
const featuredProduct = products.find((product) => product.id === home.data.featuredProduct) ?? products[0]
const sacrificeCards = [
  { id: 'face', name: '顔', image: '/assets/cards/face-card.png' },
  { id: 'language', name: '言語', image: '/assets/cards/language-card.png' },
  { id: 'love', name: '愛', image: '/assets/cards/love-card.png' },
  { id: 'vision', name: '視覚', image: '/assets/cards/vision-card.png' },
  { id: 'color', name: '色覚', image: '/assets/cards/color-card.png' },
  { id: 'intelligence', name: '知性', image: '/assets/cards/intelligence-card.png' },
]
---

<BaseLayout settings={settings.data}>
  <section class="circle-hero" aria-labelledby="hero-title">
    <img class="circle-hero-bg" src={home.data.heroImage} alt="" width="1232" height="706" loading="eager" fetchpriority="high" />
    <div class="circle-hero-overlay"></div>
    <div class="circle-hero-copy page-width">
      <p class="eyebrow">{home.data.eyebrow}</p>
      <h1 id="hero-title"><img src={home.data.logoImage} alt={home.data.title} width="3445" height="840" /></h1>
      <p class="hero-catch">{home.data.catchphrase}</p>
      <p class="hero-introduction">{home.data.introduction}</p>
      <div class="hero-actions"><a class="button primary" href="/products/">作品を見る →</a><a class="button glass" href="#creators">メンバーを見る ↓</a></div>
      {featuredProduct && <a class="hero-featured" href={`/products/${featuredProduct.id}/`}><span>Featured Product</span><strong>{featuredProduct.data.title}</strong><em>{featuredProduct.data.status} →</em></a>}
    </div>
  </section>

  <section class="products-section page-width section-space" aria-labelledby="products-title">
    <SectionHeading id="products-title" index="01" eyebrow="Products" title="制作ゲーム" copy={home.data.productsLead} />
    <div class="product-grid">{products.map((product, index) => <ProductCard product={product} featured={index === 0} />)}</div>
    <a class="text-link" href="/products/">作品一覧を見る →</a>
  </section>

  <section id="creators" class="members-section page-width section-space" aria-labelledby="members-title">
    <SectionHeading id="members-title" index="02" eyebrow="Creators" title="制作メンバー" copy={home.data.creatorsLead} />
    <div class="member-grid">{members.map((member) => <MemberCard member={member} />)}</div>
    <a class="text-link" href="/members/">プロフィールと過去作品を見る →</a>
  </section>

  <section id="articles" class="articles-section section-space" aria-labelledby="articles-title">
    <header class="compact-section-heading page-width"><p class="eyebrow">Articles & News</p><h2 id="articles-title">掲載記事・お知らせ</h2><p>{home.data.articlesLead}</p></header>
    {articles.length > 0 ? (
      <>
      <nav class="article-filters page-width" aria-label="掲載記事の絞り込み">
        <button type="button" data-article-filter="all" aria-pressed="true">すべて</button>
        <button type="button" data-article-filter="代償プロジェクト" aria-pressed="false">代償プロジェクト</button>
        <button type="button" data-article-filter="えいとえいど参加" aria-pressed="false">えいとえいど参加</button>
        <button type="button" data-article-filter="紅芋けんぴ参加" aria-pressed="false">紅芋けんぴ参加</button>
      </nav>
      <div class="article-carousel page-width" data-article-carousel>
        <div class="carousel-toolbar">
          <div class="carousel-controls">
            <button type="button" data-carousel-prev aria-label="前の記事へ" aria-controls="article-rail">←</button>
            <button type="button" data-carousel-next aria-label="次の記事へ" aria-controls="article-rail">→</button>
          </div>
        </div>
        <div id="article-rail" class="carousel-viewport" data-carousel-viewport tabindex="0" aria-label="掲載記事。左右にスライドできます">
          <div class="article-rail" data-carousel-track>{articles.map((article) => <ArticleCard article={article} />)}</div>
        </div>
      </div>
      </>
    ) : <div class="article-empty page-width"><p class="eyebrow">Coming Soon</p><h3>掲載情報を準備しています。</h3><p>記事名・掲載元・URLを追加すると、ここに一覧表示されます。</p></div>}
  </section>

  <section id="socials" class="socials-section page-width section-space" aria-labelledby="socials-title">
    <header class="compact-section-heading"><p class="eyebrow">Other Channels</p><h2 id="socials-title">他SNS・外部サイト</h2><p>{home.data.socialsLead}</p></header>
    <nav class="article-filters" aria-label="他SNS・外部サイトの絞り込み">
      <button type="button" data-social-filter="all" aria-pressed="true">すべて</button>
      <button type="button" data-social-filter="えいとえいど" aria-pressed="false">えいとえいど</button>
      <button type="button" data-social-filter="紅芋けんぴ" aria-pressed="false">紅芋けんぴ</button>
    </nav>
    <div class="social-carousel" data-horizontal-carousel>
      <div class="carousel-toolbar"><div class="carousel-controls"><button type="button" data-carousel-prev aria-label="前の外部サイトへ" aria-controls="social-link-rail">←</button><button type="button" data-carousel-next aria-label="次の外部サイトへ" aria-controls="social-link-rail">→</button></div></div>
      <div id="social-link-rail" class="carousel-viewport" data-carousel-viewport tabindex="0" aria-label="他SNS・外部サイト。左右にスライドできます">
        <div class="social-link-grid" data-carousel-track>
          {settings.data.socialLinks.map((social) => <a class="social-link-card" data-social-members={social.members.join('|')} href={social.url} target="_blank" rel="noreferrer"><div class="social-link-media" data-face-target={!social.url.includes('note.com') ? '' : undefined}><img src={social.image} alt={`${social.name}の見出し画像`} loading="lazy" decoding="async" referrerpolicy="no-referrer" /></div><div class="social-link-copy"><p>{social.label}</p><h3>{social.name}</h3><p>{social.description}</p><span>サイトを見る ↗</span></div></a>)}
        </div>
      </div>
    </div>
  </section>

  <section id="history" class="history-section page-width section-space" aria-labelledby="history-title">
    <header class="compact-section-heading"><p class="eyebrow">History</p><h2 id="history-title">これまでの歩み</h2><p>{home.data.historyLead}</p></header>
    <ol class="timeline">
      {history.map((event) => (
        <li class:list={[event.data.compact && 'compact', event.data.yearMarker && 'year-marker', (event.data.yearMarker || isFourDigitYear(event.data.date)) && 'year']}>
          <time>{event.data.date}</time>
          {!event.data.yearMarker && <div><h3>{event.data.title}</h3>{event.data.description && <p>{event.data.description}</p>}{event.data.link && <a href={event.data.link} target="_blank" rel="noreferrer">詳しく見る ↗</a>}</div>}
        </li>
      ))}
    </ol>

    <div class="sacrifice-playground" data-sacrifice-playground>
      <header class="sacrifice-heading">
        <p class="eyebrow">Sacrifice Experience</p>
        <h3>なにを"代償"にする？</h3>
        <p>カードをクリックすると、その代償がこのサイトに現れます。ページを再読み込みすると元に戻ります。</p>
      </header>
      <div class="sacrifice-carousel" data-sacrifice-carousel>
        <div class="carousel-toolbar">
          <div class="carousel-controls">
            <button type="button" data-carousel-prev aria-label="前の代償カードへ" aria-controls="sacrifice-card-rail">←</button>
            <button type="button" data-carousel-next aria-label="次の代償カードへ" aria-controls="sacrifice-card-rail">→</button>
          </div>
        </div>
        <div id="sacrifice-card-rail" class="sacrifice-card-viewport" data-carousel-viewport tabindex="0" aria-label="代償カード。左右にスライドできます">
          <div class="sacrifice-cards" data-carousel-track>
            {sacrificeCards.map((card) => (
              <button class="sacrifice-card" type="button" data-sacrifice={card.id} aria-label={`${card.name}。クリックして代償を支払う`}>
                <span class="sacrifice-card-face">
                  <img class="sacrifice-card-art" src={card.image} alt="" width="600" height="800" loading="lazy" />
                  <strong class="sacrifice-card-name">{card.name}</strong>
                  <span class="sacrifice-flame" aria-hidden="true"></span>
                </span>
              </button>
            ))}
          </div>
        </div>
      </div>
      <p class="sacrifice-result" data-sacrifice-result aria-live="polite"></p>
    </div>
  </section>
</BaseLayout>

<script>
  document.querySelectorAll<HTMLElement>('[data-horizontal-carousel], [data-article-carousel], [data-sacrifice-carousel]').forEach((carousel) => {
    const viewport = carousel.querySelector<HTMLElement>('[data-carousel-viewport]')
    const track = viewport?.querySelector<HTMLElement>('[data-carousel-track]')
    const cards = [...(track?.children ?? [])] as HTMLElement[]
    const previous = carousel.querySelector<HTMLButtonElement>('[data-carousel-prev]')
    const next = carousel.querySelector<HTMLButtonElement>('[data-carousel-next]')
    if (!viewport || !track || !previous || !next || cards.length === 0) return

    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)')
    const step = () => (cards.find((card) => !card.hidden)?.getBoundingClientRect().width ?? viewport.clientWidth) + Number.parseFloat(getComputedStyle(track).gap || '0')
    const update = () => {
      const maxScroll = Math.max(0, viewport.scrollWidth - viewport.clientWidth)
      previous.disabled = viewport.scrollLeft <= 4
      next.disabled = viewport.scrollLeft >= maxScroll - 4
    }
    const move = (direction: number) => viewport.scrollBy({ left: step() * direction, behavior: reducedMotion.matches ? 'auto' : 'smooth' })

    previous.addEventListener('click', () => move(-1))
    next.addEventListener('click', () => move(1))
    viewport.addEventListener('keydown', (event) => {
      if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') return
      event.preventDefault()
      move(event.key === 'ArrowLeft' ? -1 : 1)
    })
    viewport.addEventListener('scroll', update, { passive: true })
    carousel.addEventListener('carousel-refresh', () => {
      viewport.scrollLeft = 0
      update()
    })
    new ResizeObserver(update).observe(viewport)
    update()
  })

  const articleCarousel = document.querySelector<HTMLElement>('[data-article-carousel]')
  const filterButtons = [...document.querySelectorAll<HTMLButtonElement>('[data-article-filter]')]
  const articleCards = [...(articleCarousel?.querySelectorAll<HTMLElement>('[data-article-groups]') ?? [])]
  filterButtons.forEach((button) => button.addEventListener('click', () => {
    const selected = button.dataset.articleFilter ?? 'all'
    filterButtons.forEach((item) => item.setAttribute('aria-pressed', String(item === button)))
    articleCards.forEach((card) => {
      const groups = card.dataset.articleGroups?.split('|') ?? []
      card.hidden = selected !== 'all' && !groups.includes(selected)
    })
    articleCarousel?.dispatchEvent(new Event('carousel-refresh'))
  }))

  const socialCarousel = document.querySelector<HTMLElement>('.social-carousel')
  const socialFilterButtons = [...document.querySelectorAll<HTMLButtonElement>('[data-social-filter]')]
  const socialItems = [...(socialCarousel?.querySelectorAll<HTMLElement>('[data-social-members]') ?? [])]
  socialFilterButtons.forEach((button) => button.addEventListener('click', () => {
    const selected = button.dataset.socialFilter ?? 'all'
    socialFilterButtons.forEach((item) => item.setAttribute('aria-pressed', String(item === button)))
    socialItems.forEach((item) => {
      const members = item.dataset.socialMembers?.split('|') ?? []
      item.hidden = selected !== 'all' && !members.includes(selected)
    })
    socialCarousel?.dispatchEvent(new Event('carousel-refresh'))
  }))

  const playground = document.querySelector<HTMLElement>('[data-sacrifice-playground]')
  const sacrificeCards = [...(playground?.querySelectorAll<HTMLButtonElement>('[data-sacrifice]') ?? [])]
  const sacrificeResult = playground?.querySelector<HTMLElement>('[data-sacrifice-result]')
  const sacrificeManager = (window as Window & { daishoSacrifice?: { activate: (effect: string) => void, getState: () => string[], formatText: (text: string) => string } }).daishoSacrifice
  const paidSacrifices = new Set(sacrificeManager?.getState() ?? [])

  const refreshCards = () => {
    const terminalLoss = paidSacrifices.has('love') || paidSacrifices.has('vision')
    sacrificeCards.forEach((card) => {
      const paid = paidSacrifices.has(card.dataset.sacrifice ?? '')
      card.hidden = paid
      card.disabled = terminalLoss && !paid
    })
    playground?.querySelector<HTMLElement>('[data-sacrifice-carousel]')?.dispatchEvent(new Event('carousel-refresh'))
  }

  const finishSacrifice = (card: HTMLButtonElement, sacrifice: string) => {
    paidSacrifices.add(sacrifice)
    card.classList.add('is-gone')
    card.hidden = true
    playground?.querySelector<HTMLElement>('[data-sacrifice-carousel]')?.dispatchEvent(new Event('carousel-refresh'))
    sacrificeManager?.activate(sacrifice)
    if (sacrificeResult) {
      const message = `${card.getAttribute('aria-label')?.split('。')[0] ?? '何か'}を支払った`
      sacrificeResult.textContent = sacrificeManager?.formatText(message) ?? message
    }
    if (paidSacrifices.size === sacrificeCards.length && sacrificeResult) {
      const message = 'すべての代償を支払った'
      sacrificeResult.textContent = sacrificeManager?.formatText(message) ?? message
      playground?.classList.add('is-complete')
    }
  }

  sacrificeCards.forEach((card) => card.addEventListener('click', () => {
    const sacrifice = card.dataset.sacrifice
    if (!sacrifice || card.classList.contains('is-burning')) return
    card.disabled = true
    card.classList.add('is-burning')
    window.setTimeout(() => finishSacrifice(card, sacrifice), 1250)
  }))
  refreshCards()
</script>
