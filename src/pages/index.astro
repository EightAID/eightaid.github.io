---
import { Image } from 'astro:assets'
import { getCollection, getEntry } from 'astro:content'
import BaseLayout from '../layouts/BaseLayout.astro'
import SectionHeading from '../components/ui/SectionHeading.astro'
import ScreenshotGallery from '../components/sections/ScreenshotGallery.astro'
import MemberCard from '../components/cards/MemberCard.astro'
import { getSiteImage } from '../lib/images'

const settings = await getEntry('settings', 'site')
const home = await getEntry('home', 'home')
const special = await getEntry('special', 'daisho-shojo')
const members = (await getCollection('members')).sort((a, b) => a.data.order - b.data.order)

if (!settings || !home || !special) throw new Error('Required site content is missing')

const heroImage = getSiteImage(home.data.heroImage)
---

<BaseLayout settings={settings.data}>
  <section class="hero page-width" aria-labelledby="hero-title">
    <div class="hero-visual">
      <Image src={heroImage} alt={home.data.heroAlt} widths={[600, 900, 1200]} sizes="(max-width: 900px) 100vw, 62vw" loading="eager" fetchpriority="high" />
      <div class="hero-visual-meta" aria-hidden="true">
        <span>Visual 01</span>
        <span>Daishou Shojo</span>
      </div>
    </div>

    <div class="hero-copy">
      <p class="eyebrow">{home.data.eyebrow}</p>
      <h1 id="hero-title">{home.data.title}</h1>
      <p class="hero-catch">{home.data.catchphrase}</p>
      <p class="hero-introduction">{home.data.introduction}</p>
      <div class="hero-actions">
        <a class="button primary" href={settings.data.links.steam} target="_blank" rel="noreferrer">Steamで見る ↗</a>
        <a class="button quiet" href="/special/">作品について →</a>
      </div>
      <dl class="hero-facts">
        <div><dt>Title</dt><dd>{home.data.gameTitle}</dd></div>
        <div><dt>Genre</dt><dd>カードバトルADV</dd></div>
        <div><dt>Status</dt><dd>{home.data.releaseLabel}</dd></div>
      </dl>
    </div>
  </section>

  <section class="intro-section page-width section-space" aria-labelledby="intro-title">
    <SectionHeading index="01" eyebrow="Current Project" title={home.data.gameTitle} copy={home.data.gameSummary} />
    <div class="feature-list">
      {special.data.features.map((feature) => (
        <article class="feature-item">
          <span>{feature.number}</span>
          <h3>{feature.title}</h3>
          <p>{feature.copy}</p>
        </article>
      ))}
    </div>
    <a class="text-link" href="/special/">『代償少女』特設ページへ →</a>
  </section>

  <section class="gallery-section section-space" aria-labelledby="gallery-title">
    <div class="page-width">
      <SectionHeading index="02" eyebrow="Scenes" title="ゲーム画面" copy={home.data.galleryLead} />
    </div>
    <ScreenshotGallery screenshots={home.data.screenshots} />
  </section>

  <section class="movie-section page-width section-space" aria-labelledby="movie-title">
    <div class="movie-frame">
      <iframe
        src="https://www.youtube-nocookie.com/embed/jGvsuUJM0E0"
        title="『代償少女』正式発表PV"
        loading="lazy"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
        allowfullscreen
      ></iframe>
    </div>
    <div class="movie-copy">
      <p class="eyebrow">03 / Movie</p>
      <h2 id="movie-title">正式発表PV</h2>
      <p>{home.data.movieLead}</p>
      <a class="text-link" href={settings.data.links.youtube} target="_blank" rel="noreferrer">YouTubeで見る ↗</a>
    </div>
  </section>

  <section class="members-section page-width section-space" aria-labelledby="members-title">
    <SectionHeading index="04" eyebrow="Creators" title="制作メンバー" copy="企画・実装と、イラスト・シナリオ。二つの視点から、遊びと物語をひとつにします。" />
    <div class="member-grid">
      {members.map((member, index) => <MemberCard member={member} index={index} />)}
    </div>
    <a class="text-link" href="/members/">メンバーと過去作品を見る →</a>
  </section>
</BaseLayout>
