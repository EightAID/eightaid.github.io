---
import { getCollection, getEntry } from 'astro:content'
import BaseLayout from '../layouts/BaseLayout.astro'
import SectionHeading from '../components/ui/SectionHeading.astro'
import MemberCard from '../components/cards/MemberCard.astro'
import ProductCard from '../components/cards/ProductCard.astro'
import ArticleCard from '../components/cards/ArticleCard.astro'

const settings = await getEntry('settings', 'site')
const home = await getEntry('home', 'home')
const members = (await getCollection('members')).sort((a, b) => a.data.order - b.data.order)
const products = (await getCollection('products')).sort((a, b) => a.data.order - b.data.order)
const articles = (await getCollection('articles')).filter((article) => !article.data.draft).sort((a, b) => a.data.order - b.data.order)
const history = (await getCollection('history')).sort((a, b) => a.data.order - b.data.order)
if (!settings || !home) throw new Error('Required site content is missing')
const featuredProduct = products.find((product) => product.id === home.data.featuredProduct) ?? products[0]
---

<BaseLayout settings={settings.data} image={featuredProduct?.data.socialImage ?? '/images/daisho-main-visual.png'}>
  <section class="circle-hero" aria-labelledby="hero-title">
    <img class="circle-hero-bg" src={home.data.heroImage} alt="" width="1232" height="706" loading="eager" fetchpriority="high" />
    <div class="circle-hero-overlay"></div>
    <div class="circle-hero-copy page-width">
      <p class="eyebrow">{home.data.eyebrow}</p>
      <h1 id="hero-title"><img src={home.data.logoImage} alt={home.data.title} width="3445" height="840" /></h1>
      <p class="hero-catch">{home.data.catchphrase}</p>
      <p class="hero-introduction">{home.data.introduction}</p>
      <div class="hero-actions"><a class="button primary" href="/products/">作品を見る →</a><a class="button glass" href="#creators">メンバーを見る ↓</a></div>
      {featuredProduct && <a class="hero-featured" href={`/products/${featuredProduct.id}/`}><span>Featured Product</span><strong>{featuredProduct.data.title}</strong><em>{featuredProduct.data.status} →</em></a>}
    </div>
  </section>

  <section class="products-section page-width section-space" aria-labelledby="products-title">
    <SectionHeading id="products-title" index="01" eyebrow="Products" title="現在のプロダクト" copy={home.data.productsLead} />
    <div class="product-grid">{products.map((product, index) => <ProductCard product={product} featured={index === 0} />)}</div>
    <a class="text-link" href="/products/">作品一覧を見る →</a>
  </section>

  <section id="creators" class="members-section page-width section-space" aria-labelledby="members-title">
    <SectionHeading id="members-title" index="02" eyebrow="Creators" title="制作メンバー" copy={home.data.creatorsLead} />
    <div class="member-grid">{members.map((member) => <MemberCard member={member} />)}</div>
    <a class="text-link" href="/members/">プロフィールと過去作品を見る →</a>
  </section>

  <section id="socials" class="socials-section page-width section-space" aria-labelledby="socials-title">
    <header class="compact-section-heading"><p class="eyebrow">Other Channels</p><h2 id="socials-title">他SNS・外部サイト</h2><p>{home.data.socialsLead}</p></header>
    <div class="social-link-grid">
      {settings.data.socialLinks.map((social) => <a class="social-link-card" href={social.url} target="_blank" rel="noreferrer"><span class="social-mark" aria-hidden="true">{social.name.slice(0, 1)}</span><div><p>{social.label}</p><h3>{social.name}</h3><p>{social.description}</p></div><span class="round-arrow" aria-hidden="true">↗</span></a>)}
    </div>
  </section>

  <section id="articles" class="articles-section section-space" aria-labelledby="articles-title">
    <header class="compact-section-heading page-width"><p class="eyebrow">Articles & News</p><h2 id="articles-title">掲載記事・お知らせ</h2><p>{home.data.articlesLead}</p></header>
    {articles.length > 0 ? <div class="article-rail page-width">{articles.map((article) => <ArticleCard article={article} />)}</div> : <div class="article-empty page-width"><p class="eyebrow">Coming Soon</p><h3>掲載情報を準備しています。</h3><p>記事名・掲載元・URLを追加すると、ここに一覧表示されます。</p></div>}
  </section>

  <section id="history" class="history-section page-width section-space" aria-labelledby="history-title">
    <header class="compact-section-heading"><p class="eyebrow">History</p><h2 id="history-title">これまでの歩み</h2><p>{home.data.historyLead}</p></header>
    <ol class="timeline">
      {history.map((event) => <li><time>{event.data.date}</time><div><h3>{event.data.title}</h3><p>{event.data.description}</p>{event.data.link && <a href={event.data.link} target="_blank" rel="noreferrer">詳しく見る ↗</a>}</div></li>)}
    </ol>
  </section>
</BaseLayout>
