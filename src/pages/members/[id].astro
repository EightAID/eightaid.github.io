---
import { Image } from 'astro:assets'
import { getCollection, getEntry, type CollectionEntry } from 'astro:content'
import BaseLayout from '../../layouts/BaseLayout.astro'
import WorkCard from '../../components/cards/WorkCard.astro'
import SectionHeading from '../../components/ui/SectionHeading.astro'
import { getSiteImage } from '../../lib/images'

export async function getStaticPaths() {
  const members = await getCollection('members')
  return members.map((member) => ({ params: { id: member.id }, props: { member } }))
}

interface Props { member: CollectionEntry<'members'> }
const { member } = Astro.props
const settings = await getEntry('settings', 'site')
if (!settings) throw new Error('Site settings are missing')
const portrait = getSiteImage(member.data.image)
const worksCatalog = await getEntry('works', 'all')
const works = (worksCatalog?.data.items ?? [])
  .filter((work) => work.members.includes(member.id))
  .sort((a, b) => {
    const yearDifference = b.year - a.year
    if (yearDifference !== 0) return yearDifference
    return (b.publishedAt?.getTime() ?? 0) - (a.publishedAt?.getTime() ?? 0)
  })
---

<BaseLayout settings={settings.data} title={member.data.name} description={member.data.bio} imageAlt={`${member.data.name} | 代償プロジェクト`}>
  <section class="profile-hero page-width">
    <div class="profile-image">
      <Image src={portrait} alt={member.data.imageAlt} widths={[480, 720, 960]} sizes="(max-width: 800px) 100vw, 50vw" style={`object-position:${member.data.imagePosition ?? 'center'}`} />
    </div>
    <div class="profile-copy">
      <p class="eyebrow">Creator / {member.data.role}</p>
      <h1 data-fit-text>{member.data.name}</h1>
      <p class="profile-role">{member.data.role}</p>
      <p class="profile-bio">{member.data.bio}</p>
      <div class="profile-links">
        <a class="button primary" href={member.data.xUrl} target="_blank" rel="noreferrer">Xを見る ↗</a>
        {member.data.portfolioUrl && <a class="button quiet" href={member.data.portfolioUrl} target="_blank" rel="noreferrer">Portfolio ↗</a>}
      </div>
    </div>
  </section>

  <section class="works-section page-width section-space" aria-labelledby="works-title">
    <SectionHeading id="works-title" index="01" eyebrow="Selected Works" title="これまでの制作" copy={`${member.data.name}が参加した作品です。`} />
    <div class="works-grid">
      {works.map((work) => <WorkCard work={work} />)}
    </div>
  </section>
</BaseLayout>
