---
import { getCollection, getEntry } from 'astro:content'
import BaseLayout from '../../layouts/BaseLayout.astro'
import MemberCard from '../../components/cards/MemberCard.astro'

const settings = await getEntry('settings', 'site')
if (!settings) throw new Error('Site settings are missing')
const members = (await getCollection('members')).sort((a, b) => a.data.order - b.data.order)
---

<BaseLayout settings={settings.data} title="メンバー" description="代償プロジェクトの制作メンバーを紹介します。">
  <section class="members-index page-width listing-page" aria-labelledby="member-list-title">
    <header class="compact-page-heading"><p class="eyebrow">Creators</p><h1 id="member-list-title">制作メンバー</h1><p>それぞれの専門性を持ち寄って、ゲームを制作しています。</p></header>
    <div class="member-grid">{members.map((member) => <MemberCard member={member} />)}</div>
  </section>
</BaseLayout>
