---
import { getCollection, getEntry } from 'astro:content'
import BaseLayout from '../../layouts/BaseLayout.astro'
import SectionHeading from '../../components/ui/SectionHeading.astro'
import MemberCard from '../../components/cards/MemberCard.astro'

const settings = await getEntry('settings', 'site')
if (!settings) throw new Error('Site settings are missing')
const members = (await getCollection('members')).sort((a, b) => a.data.order - b.data.order)
---

<BaseLayout settings={settings.data} title="メンバー" description="代償プロジェクトの制作メンバーを紹介します。">
  <section class="page-intro page-width">
    <p class="eyebrow">Creators / Daishou Project</p>
    <h1>制作メンバー</h1>
    <p>異なる専門性を行き来しながら、遊びと物語が同じ感触を残すゲームを制作しています。</p>
  </section>

  <section class="members-index page-width section-space" aria-labelledby="member-list-title">
    <SectionHeading index="01" eyebrow="Members" title="二人でつくる、ひとつの体験。" />
    <div class="member-grid">
      {members.map((member, index) => <MemberCard member={member} index={index} />)}
    </div>
  </section>
</BaseLayout>
