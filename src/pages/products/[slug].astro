---
import { Image } from 'astro:assets'
import { getCollection, getEntry, type CollectionEntry } from 'astro:content'
import BaseLayout from '../../layouts/BaseLayout.astro'
import ScreenshotGallery from '../../components/sections/ScreenshotGallery.astro'
import SectionHeading from '../../components/ui/SectionHeading.astro'
import { getSiteImage } from '../../lib/images'

export async function getStaticPaths() {
  const products = await getCollection('products')
  return products.map((product) => ({ params: { slug: product.id }, props: { product } }))
}
interface Props { product: CollectionEntry<'products'> }
const { product } = Astro.props
const settings = await getEntry('settings', 'site')
if (!settings) throw new Error('Site settings are missing')
const heroImage = getSiteImage(product.data.heroImage)
---
<BaseLayout settings={settings.data} title={product.data.title} description={product.data.lead} image={product.data.socialImage}>
  <section class="product-hero page-width">
    <div class="product-hero-copy"><p class="eyebrow">{product.data.eyebrow}</p><h1>{product.data.title}</h1><p class="product-catch">{product.data.catchphrase}</p><p class="product-lead">{product.data.lead}</p><div class="hero-actions">{product.data.links.map((link, index) => <a class:list={['button', index === 0 ? 'primary' : 'quiet']} href={link.url} target="_blank" rel="noreferrer">{link.label} ↗</a>)}</div></div>
    <div class="product-hero-image"><Image src={heroImage} alt={product.data.heroAlt} widths={[600, 900, 1200]} sizes="(max-width: 900px) 100vw, 55vw" loading="eager" fetchpriority="high" /></div>
  </section>
  <section class="facts-strip" aria-label="作品基本情報"><dl class="page-width">{product.data.facts.map((fact) => <div><dt>{fact.label}</dt><dd>{fact.value}</dd></div>)}</dl></section>
  <section class="narrative-section page-width section-space"><article><p class="eyebrow">01 / Story</p><h2>{product.data.storyTitle}</h2><p>{product.data.story}</p></article><article><p class="eyebrow">02 / System</p><h2>{product.data.systemTitle}</h2><p>{product.data.system}</p></article></section>
  <section class="feature-section page-width section-space" aria-labelledby="feature-title"><SectionHeading index="03" eyebrow="Core Experience" title="『代償少女』の特徴" /><div class="feature-list large">{product.data.features.map((feature) => <article class="feature-item"><span>{feature.number}</span><h3>{feature.title}</h3><p>{feature.copy}</p></article>)}</div></section>
  <section class="gallery-section section-space" aria-labelledby="product-gallery-title"><div class="page-width"><SectionHeading index="04" eyebrow="Scenes" title="ゲーム画面" copy="現在公開しているゲーム画面。" /></div><ScreenshotGallery screenshots={product.data.screenshots} /></section>
  {product.data.movie && <section class="movie-section page-width section-space" aria-labelledby="movie-title"><div class="movie-frame"><iframe src={`https://www.youtube-nocookie.com/embed/${product.data.movie.youtubeId}`} title={`${product.data.title} ${product.data.movie.title}`} loading="lazy" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen></iframe></div><div class="movie-copy"><p class="eyebrow">05 / Movie</p><h2 id="movie-title">{product.data.movie.title}</h2><p>{product.data.movie.lead}</p><a class="text-link" href={product.data.movie.url} target="_blank" rel="noreferrer">YouTubeで見る ↗</a></div></section>}
  <section class="final-cta page-width section-space"><p class="eyebrow">Discover the Product</p><h2>{product.data.catchphrase}</h2><div>{product.data.links.map((link, index) => <a class:list={['button', index === 0 ? 'primary' : 'quiet']} href={link.url} target="_blank" rel="noreferrer">{link.label} ↗</a>)}</div></section>
</BaseLayout>
