---
import { Image } from 'astro:assets'
import { getCollection, getEntry, type CollectionEntry } from 'astro:content'
import BaseLayout from '../../layouts/BaseLayout.astro'
import ScreenshotGallery from '../../components/sections/ScreenshotGallery.astro'
import SectionHeading from '../../components/ui/SectionHeading.astro'
import { getSiteImage } from '../../lib/images'

export async function getStaticPaths() {
  const products = await getCollection('products')
  return products.map((product) => ({ params: { slug: product.id }, props: { product } }))
}
interface Props { product: CollectionEntry<'products'> }
const { product } = Astro.props
const settings = await getEntry('settings', 'site')
if (!settings) throw new Error('Site settings are missing')
const heroImage = getSiteImage(product.data.heroImage)
---
<BaseLayout settings={settings.data} title={product.data.title} description={product.data.lead}>
  <section class="product-hero page-width">
    <div class="product-hero-copy"><p class="eyebrow">{product.data.eyebrow}</p><h1 data-fit-text>{product.data.title}</h1><p class="product-catch">{product.data.catchphrase}</p><p class="product-lead">{product.data.lead}</p><div class="hero-actions">{product.data.links.map((link, index) => <a class:list={['button', index === 0 ? 'primary' : 'quiet']} href={link.url} target="_blank" rel="noreferrer">{link.label} ↗</a>)}</div></div>
    <div class="product-hero-image"><Image src={heroImage} alt={product.data.heroAlt} widths={[600, 900, 1200]} sizes="(max-width: 900px) 100vw, 55vw" loading="eager" fetchpriority="high" /></div>
  </section>
  <section class="facts-strip" aria-label="作品基本情報"><dl class="page-width">{product.data.facts.map((fact) => <div><dt>{fact.label}</dt><dd>{fact.value}</dd></div>)}{product.data.publisher && <div><dt>Publisher</dt><dd>{product.data.publisher.shortName}</dd></div>}</dl></section>
  <section class="feature-section page-width section-space" aria-labelledby="feature-title"><SectionHeading index="01" eyebrow="Core Experience" title="『代償少女』の特徴" /><div class="feature-list large">{product.data.features.map((feature) => <article class="feature-item"><span>{feature.number}</span><h3>{feature.title}</h3><p>{feature.copy}</p></article>)}</div></section>
  <section class="gallery-section section-space" aria-labelledby="product-gallery-title"><div class="page-width"><SectionHeading index="02" eyebrow="Scenes" title="ゲーム画面" copy="現在公開しているゲーム画面。" /></div><ScreenshotGallery screenshots={product.data.screenshots} /></section>
  {product.data.music && <section class="music-area page-width section-space" aria-labelledby="music-title"><SectionHeading id="music-title" index="03" eyebrow="Music" title="楽曲" copy={product.data.music.lead} /><div class="music-section"><article class="music-profile"><div class="music-profile-header"><div class="music-profile-image"><img src={product.data.music.composerImage} alt={`${product.data.music.composer}さんのプロフィール画像`} width="160" height="160" loading="lazy" /></div><div><p class="eyebrow">Composer</p><h3>{product.data.music.composer}</h3></div></div><p>{product.data.music.profile}</p><dl class="profile-details music-profile-details" data-birthday-loss aria-label={`${product.data.music.composer}さんのプロフィール情報`}><div><dt>誕生日</dt><dd>{product.data.music.composerBirthday}</dd></div><div><dt>血液型</dt><dd>{product.data.music.composerBloodType}</dd></div><div><dt>星座</dt><dd>{product.data.music.composerZodiac}</dd></div></dl><div class="composer-links"><a class="composer-link" href={product.data.music.composerUrl} target="_blank" rel="noreferrer"><span class="composer-link-icon" aria-hidden="true">YT</span>YouTube</a><a class="composer-link" href={product.data.music.composerXUrl} target="_blank" rel="noreferrer"><span class="composer-link-icon" aria-hidden="true">X</span>X</a><a class="composer-link" href={product.data.music.composerBoothUrl} target="_blank" rel="noreferrer"><span class="composer-link-icon" aria-hidden="true">B</span>BOOTH</a></div></article><div class="music-video"><iframe src={`https://www.youtube-nocookie.com/embed/${product.data.music.youtubeId}`} title={`${product.data.music.composer} - ${product.data.music.title}`} loading="lazy" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen></iframe><div class="music-video-copy"><p class="eyebrow">Battle Music</p><h3>{product.data.music.title}</h3><p>{product.data.music.songLead}</p><a class="text-link" href={product.data.music.url} target="_blank" rel="noreferrer">YouTubeで聴く ↗</a></div></div></div></section>}
  {product.data.publisher && <section class="publisher-section page-width section-space" aria-labelledby="publisher-title"><SectionHeading id="publisher-title" index="04" eyebrow="Publisher" title="パブリッシャー" copy="ゲームの宣伝・販売を担い、作品をより多くの方へ届けるパートナーです。" /><article class="publisher-card"><img class="publisher-logo" src={product.data.publisher.logo} alt={product.data.publisher.name} width="400" height="400" loading="lazy" /><div class="publisher-copy"><p class="eyebrow">Publisher</p><h3>{product.data.publisher.name}</h3><p class="publisher-catch">{product.data.publisher.catchphrase}</p><p>{product.data.publisher.description}</p><a class="button quiet publisher-link" href={product.data.publisher.url} target="_blank" rel="noreferrer">公式サイトを見る ↗</a></div></article></section>}
  {product.data.movie && <section class="movie-section page-width section-space" aria-labelledby="movie-title"><div class="movie-frame"><iframe src={`https://www.youtube-nocookie.com/embed/${product.data.movie.youtubeId}`} title={`${product.data.title} ${product.data.movie.title}`} loading="lazy" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen></iframe></div><div class="movie-copy"><p class="eyebrow">05 / Movie</p><h2 id="movie-title">{product.data.movie.title}</h2><p>{product.data.movie.lead}</p><a class="text-link" href={product.data.movie.url} target="_blank" rel="noreferrer">YouTubeで見る ↗</a></div></section>}
  <section class="final-cta page-width section-space"><p class="eyebrow">Discover the Product</p><h2>『{product.data.title}』をチェックする</h2><div>{product.data.links.map((link, index) => <a class:list={['button', index === 0 ? 'primary' : 'quiet']} href={link.url} target="_blank" rel="noreferrer">{link.label} ↗</a>)}</div></section>
</BaseLayout>
